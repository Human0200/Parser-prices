# Database
DATABASE_URL=postgresql+asyncpg://priceradar:changeme@db:5432/priceradar
DATABASE_URL_SYNC=postgresql+psycopg2://priceradar:changeme@db:5432/priceradar
DB_PASSWORD=changeme

# Redis
REDIS_URL=redis://redis:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_BOT_USERNAME=PriceRadarBot

# YooKassa
YUKASSA_SHOP_ID=123456
YUKASSA_SECRET_KEY=test_...

# Parsing
# Optional browser cookies for antibot bypass (full Cookie header value)
# Example: OZON_COOKIES=abt_data=....
# Example: WB_COOKIES=_wbauid=...; x_wbaas_token=...
OZON_COOKIES=
WB_COOKIES=
# Optional: Authorization Bearer <jwt> from browser Network tab
WB_AUTHORIZATION=
PARSE_INTERVAL=900

# App
SECRET_KEY=supersecretkey
DEBUG=false
BASE_URL=http://localhost:8000
